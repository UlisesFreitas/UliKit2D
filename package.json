{
  "name": "ulikit2d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5175 && npm run build:electron && electron dist/electron/main.js --dev\"",
    "build:electron:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node18 --external:electron --outfile=dist/electron/main.js",
    "build:electron:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node18 --external:electron --outfile=dist/electron/preload.js",
    "build:electron": "npm run build:electron:main && npm run build:electron:preload",
    "build": "vue-tsc -b && vite build && npm run build:electron",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixi/events": "^7.4.3",
    "@vueuse/core": "^14.1.0",
    "chokidar": "^4.0.3",
    "dockview-core": "^4.13.1",
    "lucide-vue-next": "^0.562.0",
    "matter-js": "^0.20.0",
    "miniplex": "^2.0.0",
    "nanoid": "^5.1.6",
    "pinia": "^3.0.4",
    "pixi.js": "^8.14.3",
    "radix-vue": "^1.9.17",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^5.4.11",
    "vue-tsc": "^3.1.4",
    "wait-on": "^9.0.3"
  }
}
